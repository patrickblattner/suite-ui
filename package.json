{
  "name": "@suite/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "parity-map.json"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./list/*": {
      "types": "./dist/list/*.d.ts",
      "import": "./dist/list/*.js"
    },
    "./settings/*": {
      "types": "./dist/settings/*.d.ts",
      "import": "./dist/settings/*.js"
    },
    "./shell/*": {
      "types": "./dist/shell/*.d.ts",
      "import": "./dist/shell/*.js"
    },
    "./help/*": {
      "types": "./dist/help/*.d.ts",
      "import": "./dist/help/*.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./strings": {
      "types": "./dist/strings/index.d.ts",
      "import": "./dist/strings/index.js"
    },
    "./parity": {
      "types": "./dist/parity/index.d.ts",
      "import": "./dist/parity/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "suite-ui-parity": "./dist/parity/cli.js"
  },
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gallery": "playwright test --config gallery/playwright.config.ts",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "parity": "node dist/parity/cli.js"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": ">=1.17.0",
    "radix-ui": "^1.5",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-i18next": ">=15 <18",
    "react-markdown": ">=9 <11",
    "react-router-dom": "^7",
    "remark-gfm": "^4",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.4.2",
    "jsdom": "^27.4.0",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "spec-sync-toolkit": "github:patrickblattner/spec-sync-toolkit#v0.22.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
