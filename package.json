{
  "name": "@suite/ui",
  "version": "0.235.1",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "files": [
    "dist",
    "parity-map.json"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./dist/parity/cli.js"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./list/*": {
      "types": "./dist/list/*.d.ts",
      "import": "./dist/list/*.js"
    },
    "./settings/*": {
      "types": "./dist/settings/*.d.ts",
      "import": "./dist/settings/*.js"
    },
    "./shell/*": {
      "types": "./dist/shell/*.d.ts",
      "import": "./dist/shell/*.js"
    },
    "./slides/*": {
      "types": "./dist/slides/*.d.ts",
      "import": "./dist/slides/*.js"
    },
    "./operation-status/provider": {
      "types": "./dist/operation-status/provider.d.ts",
      "import": "./dist/operation-status/provider.js"
    },
    "./help/*": {
      "types": "./dist/help/*.d.ts",
      "import": "./dist/help/*.js"
    },
    "./strings": {
      "types": "./dist/strings/index.d.ts",
      "import": "./dist/strings/index.js"
    },
    "./strings/en": {
      "types": "./dist/strings/en.d.ts",
      "import": "./dist/strings/en.js"
    },
    "./strings/de": {
      "types": "./dist/strings/de.d.ts",
      "import": "./dist/strings/de.js"
    },
    "./strings/es": {
      "types": "./dist/strings/es.d.ts",
      "import": "./dist/strings/es.js"
    },
    "./parity": {
      "types": "./dist/parity/index.d.ts",
      "import": "./dist/parity/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "suite-ui-parity": "./dist/parity/cli.js"
  },
  "scripts": {
    "prepare": "tsup && (simple-git-hooks || echo 'warning: simple-git-hooks failed — no pre-push hook (secret guard) is installed; run npx simple-git-hooks in the git checkout' >&2)",
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gallery": "playwright test --config gallery/playwright.config.ts",
    "gallery:image": "spec-sync slot run --step gallery --cap 35 -- bash scripts/gallery-image.sh",
    "pptx:render": "spec-sync slot run --step pptx-render --cap 15 -- bash scripts/pptx-render.sh",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "parity": "node dist/parity/cli.js",
    "gate:record": "node scripts/release.ts record",
    "release:tag": "node scripts/release.ts tag",
    "knip": "node scripts/hygiene.ts knip",
    "hygiene": "node scripts/hygiene.ts gate",
    "hygiene:inventory": "node scripts/hygiene.ts inventory",
    "growth:metrics": "node scripts/growth-metrics.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "jiti": "^2.7.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": ">=1.17.0",
    "radix-ui": "^1.5",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-i18next": ">=15 <18",
    "react-markdown": ">=9 <11",
    "react-router-dom": "^7",
    "remark-gfm": "^4",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fta-cli": "^3.1.0",
    "i18next": "^26.4.2",
    "jscpd": "^5.4.2",
    "jsdom": "^27.4.0",
    "knip": "^6.44.1",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.3.0",
    "sonner": "^2.0.8",
    "source-map-explorer": "^2.5.3",
    "spec-sync-toolkit": "github:patrickblattner/spec-sync-toolkit#v0.49.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "type-coverage": "^2.31.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-sonarjs": {
      "minimatch": "^11.0.1"
    },
    "type-coverage-core": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "simple-git-hooks@2.14.0": false
  },
  "simple-git-hooks": {
    "pre-push": "[ -f scripts/pre-push.ts ] || { echo 'push refused: this branch predates the pre-push hook (scripts/pre-push.ts missing) — merge or rebase main into it and push again' >&2; exit 1; }; node scripts/pre-push.ts \"$@\""
  }
}
