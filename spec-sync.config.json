{
  "project": "suite-ui",
  "gate": {
    "profiles": {
      "local": ["format", "lint", "typecheck", "unit", "gallery"],
      "merge": ["format", "lint", "typecheck", "build", "unit", "gallery"]
    },
    "phases": [
      {
        "name": "format",
        "cmd": "npm run format:check"
      },
      {
        "name": "lint",
        "cmd": "npm run lint"
      },
      {
        "name": "typecheck",
        "cmd": "npm run typecheck"
      },
      {
        "name": "build",
        "cmd": "npm run build"
      },
      {
        "name": "unit",
        "cmd": "npm test"
      },
      {
        "name": "gallery",
        "cmd": "npm run gallery:image"
      }
    ]
  },
  "lenses": {
    "code": [
      "src/!(strings)/**",
      "src/strings/!(en|de|es).ts",
      "src/strings/*.tsx",
      "src/*.{ts,tsx,css}",
      "gallery/**",
      "test/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "tsup.config.ts",
      "vitest.config.ts",
      "eslint.config.js",
      "spec-sync.config.json"
    ],
    "security": ["package.json", "package-lock.json", "src/help/help-markdown.tsx"],
    "ui": ["src/!(strings)/**/!(*.test).tsx", "src/*.css", "gallery/**"],
    "ux": ["src/!(strings)/**/!(*.test).tsx", "gallery/**"]
  },
  "labels": {
    "build": "spec-sync",
    "audit": "auto-audit",
    "bug": "type: bug",
    "hold": "owner-hold"
  },
  "codegraphProject": "suite-ui",
  "logRetention": 20
}
