{
  "project": "suite-ui",
  "measureFiles": ["quality-baseline.json", "size-limit-lines.json"],
  "gate": {
    "profiles": {
      "local": ["format", "lint", "typecheck", "build", "hygiene", "knip", "unit"],
      "merge": ["format", "lint", "typecheck", "build", "hygiene", "knip", "unit", "gallery"]
    },
    "phases": [
      {
        "name": "format",
        "cmd": "npm run format:check"
      },
      {
        "name": "lint",
        "cmd": "npm run lint",
        "blocking": true
      },
      {
        "name": "typecheck",
        "cmd": "npm run typecheck",
        "blocking": true
      },
      {
        "name": "build",
        "cmd": "npm run build",
        "blocking": true,
        "imageOnly": "builds dist with tsup; the pre-run never builds (SST-DESIGN-013)"
      },
      {
        "name": "hygiene",
        "cmd": "npm run hygiene",
        "blocking": true,
        "imageOnly": "size-limit measures dist/, which only the build phase produces (SUI-FEATURE-128)"
      },
      {
        "name": "knip",
        "cmd": "npm run knip"
      },
      {
        "name": "unit",
        "cmd": "npm test",
        "blocking": true,
        "imageOnly": "the suite includes *.dist.test.ts that read dist/, which only the build phase produces"
      },
      {
        "name": "gallery",
        "cmd": "bash scripts/gallery-image.sh",
        "imageOnly": "Playwright screenshots in the pinned Docker image (SUI-FEATURE-076); the pre-run never starts a browser"
      }
    ]
  },
  "lenses": {
    "code": [
      "src/!(strings)/**",
      "src/strings/!(en|de|es).ts",
      "src/strings/*.tsx",
      "src/*.{ts,tsx,css}",
      "gallery/**",
      "test/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "tsup.config.ts",
      "vitest.config.ts",
      "eslint.config.js",
      "spec-sync.config.json"
    ],
    "security": [
      "package.json",
      "package-lock.json",
      "src/help/help-markdown.tsx",
      "src/shell/nav.ts",
      "src/shell/app-sidebar.tsx",
      "scripts/release.ts"
    ],
    "ui": ["src/!(strings)/**/!(*.test).tsx", "src/*.css", "gallery/**"],
    "ux": ["src/!(strings)/**/!(*.test).tsx", "gallery/**"]
  },
  "review": {
    "riskGlobs": {
      "security": [
        "package.json",
        "package-lock.json",
        "src/help/help-markdown.tsx",
        "src/shell/nav.ts",
        "src/shell/app-sidebar.tsx",
        "scripts/release.ts"
      ]
    },
    "textGlobs": ["src/strings/*"]
  },
  "labels": {
    "build": "spec-sync",
    "audit": "auto-audit",
    "bug": "type: bug",
    "hold": "owner-hold"
  },
  "codegraphProject": "suite-ui",
  "logRetention": 20
}
