{
  "project": "suite-ui",
  "gate": {
    "profiles": {
      "local": ["format", "lint", "typecheck", "unit"],
      "merge": ["format", "lint", "typecheck", "unit"],
      "nightly": ["format", "lint", "typecheck", "unit"]
    },
    "phases": [
      { "name": "format", "cmd": "npm run format:check" },
      { "name": "lint", "cmd": "npm run lint" },
      { "name": "typecheck", "cmd": "npm run typecheck" },
      { "name": "unit", "cmd": "npm test" }
    ]
  },
  "lenses": {
    "acceptance": ["**"],
    "tests": ["**"],
    "a11y": ["client/**", "public/**"],
    "security": ["server/**", "worker/**", "package-lock.json", "**/auth/**"],
    "migration": ["server/migrations/**"]
  },
  "labels": {
    "build": "spec-sync",
    "audit": "auto-audit",
    "bug": "type: bug",
    "hold": "owner-hold"
  },
  "codegraphProject": "suite-ui",
  "logRetention": 20
}
