{
  "project": "suite-ui",
  "gate": {
    "profiles": {
      "local": ["format", "lint", "typecheck", "unit", "gallery"],
      "merge": ["format", "lint", "typecheck", "unit", "gallery"],
      "nightly": ["format", "lint", "typecheck", "unit", "gallery"]
    },
    "phases": [
      {
        "name": "format",
        "cmd": "npm run format:check"
      },
      {
        "name": "lint",
        "cmd": "npm run lint"
      },
      {
        "name": "typecheck",
        "cmd": "npm run typecheck"
      },
      {
        "name": "unit",
        "cmd": "npm test"
      },
      {
        "name": "gallery",
        "cmd": "npm run gallery"
      }
    ]
  },
  "lenses": {
    "acceptance": ["**"],
    "tests": ["**"],
    "a11y": ["src/**", "gallery/**"],
    "security": ["src/**", "package-lock.json"]
  },
  "labels": {
    "build": "spec-sync",
    "audit": "auto-audit",
    "bug": "type: bug",
    "hold": "owner-hold"
  },
  "codegraphProject": "suite-ui",
  "logRetention": 20
}
